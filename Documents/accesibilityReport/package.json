{
  "name": "accessibility-wcag-reporter",
  "version": "1.0.0",
  "description": "Automated WCAG accessibility testing with Cypress + axe-core and a visual report UI",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "cy:run": "cypress run --env url=$URL",
    "cy:open": "cypress open"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "cypress": "^13.6.0",
    "cypress-axe": "^1.5.0",
    "axe-core": "^4.8.3"
  }
}
